<?xml version="1.0"?>
<ruleset name="Require Email 2FA">
	<description>WordPress Coding Standards and PHP 7.2+ compatibility for the plugin code.</description>

	<file>force-email-two-factor.php</file>
	<file>uninstall.php</file>
	<file>includes</file>

	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.2-"/>
	<rule ref="PHPCompatibility"/>

	<config name="minimum_wp_version" value="6.7"/>
	<config name="text_domain" value="force-email-two-factor"/>
	<rule ref="WordPress"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="force_2fa"/>
			</property>
		</properties>
		<!-- Views are included inside a method, so their variables are local, not globals. -->
		<exclude-pattern>*/includes/views/*</exclude-pattern>
	</rule>
</ruleset>
