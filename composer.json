{
    "name": "we-are-pixel/require-email-2fa",
    "description": "Requires two-factor login on Pixel-managed WordPress sites (Require Email 2FA plugin).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.2",
        "yahnis-elsts/plugin-update-checker": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11",
        "phpcompatibility/php-compatibility": "^9.3",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "process-timeout": 0
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": [
            "bash tests/bin/setup-wp.sh single",
            "bash tests/bin/setup-wp.sh multisite",
            "phpunit",
            "WP_TESTS_MULTISITE=1 phpunit"
        ],
        "test:e2e": "bash tests/e2e/run.sh",
        "test:upgrade": "bash tests/upgrade/run.sh",
        "check": [
            "@composer audit",
            "@lint",
            "@analyse",
            "@test",
            "@test:e2e",
            "@test:upgrade"
        ]
    }
}
