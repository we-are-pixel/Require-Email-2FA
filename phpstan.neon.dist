includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	paths:
		- force-email-two-factor.php
		- uninstall.php
		- includes
	# WordPress filters can return anything, so docblock types are not guaranteed at runtime.
	treatPhpDocTypesAsCertain: false
	scanDirectories:
		- vendor/yahnis-elsts
	scanFiles:
		- tests/phpstan/two-factor.php
